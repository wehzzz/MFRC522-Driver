export KDIR=/home/eanae/MFRC522-Driver/rpi/linux
export ARCH=arm
export CROSS_COMPILE=arm-linux-gnueabihf-
export LLVM=1
export CONFIG_RUST=y
export RUST_LIB_SRC=$KDIR/rust
export RUST_TARGET=armv7-unknown-linux-gnueabihf
export RUST_TARGET_PATH=$KDIR/scripts/rust
export RUSTFLAGS="-C linker=arm-linux-gnueabihf-gcc"
